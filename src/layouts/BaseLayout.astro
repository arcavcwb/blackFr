---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	lang?: string;
}

const {
	title,
	description,
	lang = 'pt-BR',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>
