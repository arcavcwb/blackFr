---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlackFridayHeroSection from '../features/black-friday-hero/components/BlackFridayHeroSection.astro';
import CondorPremiaSection from '../features/condor-premia/components/CondorPremiaSection.astro';
import ZonSection from '../features/z-on/components/ZonSection.astro';
import GameDaBlack from '../features/game-da-black/components/GameDaBlack.astro';
import PostGameBottom from '../features/black-friday-bottom/components/PostGameBottom.astro';
import { faqPreviewItems } from '../features/black-friday-bottom/data/faqs-preview';
import { aboutContent, footerContent, gameContent, menuItems, regulationContent, seoContent } from '../data/landing-content';
import condorLogo from '../../assets/originals/branding/logo-condor-com-sombra.png';

const [gameRegulation, blackRegulation, offers] = regulationContent.botoes;
const reviewMode = import.meta.env.DEV;
const parts = (text: string) => text.split(/(\*\*[^*]+\*\*)/g).filter(Boolean);

