};
---

<BaseLayout title={seoContent.title} description={seoContent.description}>
  <Fragment slot="head">
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seoContent.title} />
    <meta property="og:description" content={seoContent.description} />
    <!-- The canonical OG image is still missing; do not emit a broken image URL. -->
    <noscript><style>.mobile-menu { display: none; }</style></noscript>
  </Fragment>
  <div class="landing">
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <nav aria-label="Seções da página" class="pointer-events-none fixed inset-x-0 top-0 z-40" data-menu>
      <ul
        class="bf-menu-pilula pointer-events-auto mx-auto mt-[55px] hidden h-[59px] w-[calc(100%-48px)] max-w-[1027px] items-center justify-around rounded-full bg-[#0003ef] px-3 md:flex"
      >
        {menuItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="bf-foco bf-menu-link rounded-full px-3 py-2 text-[14px] font-semibold text-white transition-[opacity,background-color] hover:opacity-75 lg:px-4 lg:text-[15px]"
            >
              {item.rotulo}
            </a>
          </li>
        ))}
      </ul>

      <div class="mobile-menu md:hidden">
        <button
          type="button"
          class="bf-foco bf-menu-botao pointer-events-auto absolute top-[35px] right-[12px] flex size-12 flex-col items-center justify-center gap-[4px] rounded-full bg-[#0003ef]"
          aria-expanded="false"
          aria-controls="bf-menu-movel"
          aria-label="Abrir o menu"
          data-menu-botao
        >
          <span class="h-[3px] w-[20px] rounded-full bg-white" aria-hidden="true"></span>
          <span class="h-[3px] w-[20px] rounded-full bg-white" aria-hidden="true"></span>
          <span class="h-[3px] w-[20px] rounded-full bg-white" aria-hidden="true"></span>
        </button>

        <dialog
          id="bf-menu-movel"
          class="bf-gaveta pointer-events-auto fixed inset-y-0 right-0 left-auto m-0 h-dvh max-h-none w-[min(320px,84vw)] max-w-none overflow-y-auto rounded-l-[28px] border-0 bg-[#0003ef] p-0 text-white"
          aria-label="Menu"
          data-menu-gaveta
        >
          <div class="flex min-h-full flex-col px-[24px] pt-[24px] pb-[32px]">
            <div class="flex items-center justify-between">
              <img
                src={condorLogo.src}
                alt="Condor"
                width="134"
                height="36"
                class="h-auto w-[112px]"
              />
              <button
                type="button"
                class="bf-foco -mr-[10px] grid size-11 place-items-center rounded-full"
                aria-label="Fechar o menu"
                data-menu-fechar
              >
                <svg viewBox="0 0 24 24" class="size-[26px]" aria-hidden="true">
                  <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" />
                </svg>
              </button>
            </div>

            <ul class="mt-[32px] flex flex-col">
              {menuItems.map((item) => (
                <li class="border-b border-white/25 last:border-b-0">
                  <a href={item.href} class="bf-foco bf-menu-link -mx-[12px] flex min-h-[60px] items-center rounded-[14px] px-[12px] text-[20px] font-semibold text-white">
                    {item.rotulo}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </dialog>
      </div>
    </nav>

    <script>
      // Ao rolar, a pílula (e o botão no móvel) sobem para junto da borda.
      const nav = document.querySelector<HTMLElement>("[data-menu]");
      if (nav) {
        let pendente = false;
        const marcar = () => {
          pendente = false;
          if (scrollY > 80) nav.dataset.rolado = "";
          else delete nav.dataset.rolado;
        };
        addEventListener("scroll", () => {
          if (!pendente) {
            pendente = true;
            requestAnimationFrame(marcar);
          }
        }, { passive: true });
        marcar();
      }

      // Secção atual: o link dela ganha aria-current, no desktop e no painel.
      // Só conta âncora desta página («#sobre»): fora da LP os links levam o
      // caminho na frente, e «/black-friday/#sobre» nem é um seletor válido.
      const links = [...document.querySelectorAll<HTMLAnchorElement>(".bf-menu-link")];
      const secoes = [...new Set(links.map((l) => l.getAttribute("href")))]
        .map((h) => (h?.startsWith("#") ? document.querySelector<HTMLElement>(h) : null))
        .filter((s): s is HTMLElement => !!s);
      if ("IntersectionObserver" in window && secoes.length) {
        const vigia = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (!e.isIntersecting) continue;
              const alvo = `#${e.target.id}`;
              for (const l of links) {
                if (l.getAttribute("href") === alvo) l.setAttribute("aria-current", "true");
                else l.removeAttribute("aria-current");
              }
            }
          },
          // A secção «atual» é a que cruza a faixa do meio do ecrã.
          { rootMargin: "-45% 0px -50% 0px" },
        );
        for (const s of secoes) vigia.observe(s);
      }

      const botao = document.querySelector<HTMLButtonElement>("[data-menu-botao]");
      const gaveta = document.querySelector<HTMLDialogElement>("[data-menu-gaveta]");

      if (botao && gaveta) {
        const reduzir = matchMedia("(prefers-reduced-motion: reduce)");

        botao.addEventListener("click", () => {
          gaveta.showModal();
          botao.setAttribute("aria-expanded", "true");
        });

        gaveta.addEventListener("close", () => botao.setAttribute("aria-expanded", "false"));
        gaveta.querySelector("[data-menu-fechar]")?.addEventListener("click", () => gaveta.close());

        // Toque no fundo escurecido: o clique chega ao próprio <dialog> (o
        // ::backdrop é dele), enquanto um toque no painel cai num filho.
        gaveta.addEventListener("click", (e) => {
          if (e.target === gaveta) gaveta.close();
        });

        // Fecha primeiro e rola depois. Ao fechar, o <dialog> devolve o foco ao
        // botão de três barras, lá no topo; se o link navegasse sozinho, essa
        // devolução puxava a página de volta para cima.
        for (const link of gaveta.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')) {
          link.addEventListener("click", (e) => {
            const href = link.getAttribute("href") ?? "";
            const alvo = document.querySelector<HTMLElement>(href);
            if (!alvo) return;
            e.preventDefault();
            gaveta.close();
            history.replaceState(null, "", href);
            alvo.scrollIntoView({ behavior: reduzir.matches ? "auto" : "smooth" });
            // O foco segue para a secção, para quem navega por teclado ou leitor
            // de ecrã continuar dali.
            if (!alvo.hasAttribute("tabindex")) alvo.setAttribute("tabindex", "-1");
            alvo.focus({ preventScroll: true });
          });
        }

        // Se o ecrã crescer até ao desktop com o painel aberto, ele fecha: lá o
        // menu é a pílula.
        matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
          if (e.matches && gaveta.open) gaveta.close();
        });
      }
    </script>

    <noscript>
      <nav class="no-script-menu md:hidden" aria-label="Seções da página">
        <ul>{menuItems.map((item) => <li><a href={item.href}>{item.rotulo}</a></li>)}</ul>
      </nav>
    </noscript>

    <main id="conteudo" tabindex="-1">
      <BlackFridayHeroSection />
      <section id="sobre" class="about" aria-labelledby="sobre-titulo">
        <hr class="bf-separador" />
        <div class="about__copy">
          <h2 id="sobre-titulo">{aboutContent.titulo}</h2>
          {aboutContent.paragrafos.map((paragraph) => (
            <p>{parts(paragraph).map((part) => part.startsWith('**') ? <strong>{part.slice(2, -2)}</strong> : part)}</p>
          ))}
        </div>
      </section>
      <CondorPremiaSection />
      <ZonSection />
      <section id="game-da-black" aria-label={gameContent.titulo}>
        <GameDaBlack />
      </section>
      <section id="regulamento" aria-label={regulationContent.titulo}>
        <PostGameBottom faqs={faqPreviewItems}>
          <a slot="primary" href={gameContent.cta.href}>{gameContent.cta.rotulo} <span aria-hidden="true">↗</span></a>
          {gameRegulation.href ? (
            <a slot="regulation-game" href={gameRegulation.href}>{gameRegulation.rotulo}</a>
          ) : (
            <span slot="regulation-game">{gameRegulation.rotulo}</span>
          )}
          {blackRegulation.href ? (
            <a slot="regulation-black" href={blackRegulation.href}>{blackRegulation.rotulo}</a>
          ) : (
            <span slot="regulation-black">{blackRegulation.rotulo}</span>
          )}
          <a slot="offers" href={offers.href}>{offers.rotulo}</a>
        </PostGameBottom>
      </section>
    </main>

    <footer>
      <hr class="bf-separador" />

      <div class="mx-auto flex w-[calc(100%-50px)] max-w-[1028px] flex-col items-center gap-[18px] py-[22px] lg:flex-row lg:justify-between lg:gap-[40px] lg:py-[50px]">
        <img
          src={condorLogo.src}
          alt="Condor"
          width="134"
          height="36"
          loading="lazy"
          decoding="async"
          class="h-auto w-[123px] shrink-0 lg:w-[134px]"
        />

        <p class="max-w-[552px] text-center text-[6px] leading-[1.35] font-medium text-white lg:text-[8px]">
          {footerContent.legal}
        </p>

        <ul class="flex shrink-0 items-center gap-[3px] lg:gap-[4px]" aria-label="Redes sociais do Condor">
          {footerContent.redes.map((r) => (
            <li>
              <a
                href={r.href}
                target="_blank"
                rel="noopener"
                class="bf-foco grid size-[24px] place-items-center rounded-full lg:size-[30px]"
                style={`background-color: ${r.cor}`}
                aria-label={r.rotulo}
              >
                <svg viewBox="0 0 24 24" class="size-[14px] lg:size-[16px]" style={`fill: ${r.corIcone ?? "#fff"}`} aria-hidden="true">
                  <path d={ICONES_REDES[r.rede]} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="bg-[#0003ef] px-[24px] py-[18px] lg:py-[19px]">
        <ul class="bf-rodape-links mx-auto flex max-w-[1240px] flex-wrap justify-center gap-x-[5px] gap-y-[2px] text-center text-[10px] leading-[1.4] font-medium text-white lg:gap-x-[10px] lg:text-[14px]">
          {footerContent.links.map((l, i) => (
            <li class="flex items-center justify-center gap-x-[5px] lg:gap-x-[10px]">
              {i > 0 && <span class:list={[i === 2 && "hidden lg:inline"]} aria-hidden="true">|</span>}
              {l.href ? (
                <a href={l.href} target="_blank" rel="noopener" class="bf-foco rounded hover:underline">
                  <span aria-hidden="true">{l.icone}</span> {l.rotulo}
                </a>
              ) : (
                <span><span aria-hidden="true">{l.icone}</span> {l.rotulo}</span>
              )}
            </li>
          ))}
          <li class="mt-[12px] flex w-full items-center justify-center gap-x-[10px] lg:mt-0 lg:w-auto">
            <span class="hidden lg:inline" aria-hidden="true">|</span>
            {footerContent.copyright}
          </li>
        </ul>
      </div>
    </footer>

    {reviewMode && (
      <aside class="review-note" aria-label="Pendências editoriais para revisão">
        Revisão local: FAQ provisório, destinos dos dois regulamentos, Lojas Participantes,
        Política de Privacidade, certificado SPA/ME do rodapé e imagem OG aguardam validação.
      </aside>
    )}
  </div>
</BaseLayout>

<style>
  .landing { background: #000; color: #fff; font-family: Arial, system-ui, sans-serif; }
  .landing :global(*) { box-sizing: border-box; }
  .landing :global([id]) { scroll-margin-top: 92px; }
  nav ul, footer ul { list-style: none; padding: 0; }
  footer ul, footer p { margin: 0; }
  footer a, .bf-menu-link, .skip-link, .no-script-menu a { text-decoration: none; }
  footer a:hover { text-decoration: underline; }
  .bf-rodape-links { margin-inline: auto; }
  .landing :global(.bf-foco:focus-visible) { outline: 2px solid #fff; outline-offset: 4px; }
  .skip-link { position: fixed; top: 8px; left: 8px; z-index: 50; padding: 12px 16px; background: #0003ef; color: #fff; transform: translateY(-150%); }
  .skip-link:focus { transform: translateY(0); }
  .bf-menu-pilula { margin-block: 55px 0; padding-inline: 12px; }
  .bf-menu-link { color: #fff; }
  .bf-menu-link[aria-current] { background: rgb(255 255 255 / 0.15); }
  [data-menu][data-rolado] .bf-menu-pilula { translate: 0 -43px; }
  [data-menu][data-rolado] .bf-menu-botao { translate: 0 -23px; }
  .bf-menu-botao, [data-menu-fechar] { border: 0; cursor: pointer; }
  [data-menu-fechar] { background: transparent; color: inherit; }
  .bf-gaveta ul { margin: 32px 0 0; }
  .bf-gaveta::backdrop { background: rgb(0 0 0 / 0.7); }
  .no-script-menu { background: #0003ef; padding: 12px; }
  .no-script-menu ul { margin: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; }
  .no-script-menu a { display: flex; align-items: center; min-height: 44px; padding: 8px; color: #fff; }
  .bf-separador { margin: 0 auto; height: 2px; width: calc(100% - 56px); max-width: 1027px; border: 0; background: repeating-linear-gradient(90deg, #0003ef 0 8px, transparent 8px 16px); }
  .about { padding-top: clamp(1.5rem, 1rem + 2vw, 3rem); }
  .about__copy { width: min(913px, calc(100% - 76px)); margin: 40px auto 0; text-align: center; }
  .about h2 { max-width: 199px; margin: 0 auto 20px; font-size: 20px; font-weight: 900; line-height: 1.2; letter-spacing: -0.02em; text-wrap: balance; }
  .about p { margin: 0; font-size: 13px; font-weight: 300; line-height: 1.23; }
  .about p + p { margin-top: 1em; }
  .about strong { font-weight: 800; }
  .review-note { max-width: 1028px; margin: 0 auto; padding: 24px; line-height: 1.5; }
  @media (min-width: 768px) {
    .about__copy { margin-top: 56px; }
    .about h2 { max-width: none; margin-bottom: 28px; font-size: 32px; }
    .about p { font-size: 26px; }
  }
  @media (max-width: 1023px) { .bf-rodape-links { max-width: 265px; } }
</style>
