---
import { videoContent } from '../../../data/landing-content';
import verifiedVideoSource from '../../../../assets/optimized/video/video-black-friday-2026.mp4?url';

interface Props {
	id?: string;
	class?: string;
}

const { id = 'black-friday-video', class: className = '' } = Astro.props;
---

<section
	id={id}
	aria-label={videoContent.rotulo}
	class:list={['bg-black px-[var(--page-gutter)] pb-12 pt-8 sm:pb-16 sm:pt-12 lg:pb-20', className]}
>
	<div
		class="mx-auto aspect-video w-full max-w-[1120px] overflow-hidden rounded-[clamp(1rem,2.4vw,2rem)] bg-[#071525] shadow-[0_0_0_1px_rgba(32,94,172,0.3)]"
	>
		<video
			data-promotional-video
			class="block size-full object-contain"
			controls
			muted
			playsinline
			preload="metadata"
			aria-label={videoContent.rotulo}
		>
			<source src={verifiedVideoSource} type="video/mp4" />
			<a href={verifiedVideoSource}>{videoContent.rotulo}</a>
		</video>
	</div>
</section>

<script>
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	document.querySelectorAll<HTMLVideoElement>('[data-promotional-video]').forEach((video) => {
		if (!('IntersectionObserver' in window)) return;

		let inView = false;
		let manuallyPaused = false;
		// Set the property too: browsers require muted playback for automatic starts.
		video.muted = true;

		const playWhenVisible = () => {
			if (!inView || document.hidden || reducedMotion.matches || manuallyPaused || video.ended) return;
			void video.play().catch(() => {
				// Native controls remain available if the browser blocks playback.
			});
		};

		video.addEventListener('pause', () => {
			if (inView && !document.hidden && !reducedMotion.matches && !video.ended) {
				manuallyPaused = true;
			}
		});
		video.addEventListener('play', () => {
			manuallyPaused = false;
		});

		const observer = new IntersectionObserver(([entry]) => {
			inView = entry.isIntersecting && entry.intersectionRatio >= 0.25;
			if (inView) playWhenVisible();
			else video.pause();
		}, { threshold: [0, 0.25] });
		observer.observe(video);

		document.addEventListener('visibilitychange', () => {
			if (document.hidden) video.pause();
			else playWhenVisible();
		});
		reducedMotion.addEventListener('change', () => {
			if (reducedMotion.matches) video.pause();
			else playWhenVisible();
		});
	});
</script>
