---
import type { ContactInfo } from '../types';
interface Props { contact: ContactInfo; }
const { contact } = Astro.props;
---
<article class="flex min-w-0 items-start gap-4 rounded-xl bg-[#F6F8FC] p-5 text-[#112952] shadow-[0_12px_40px_rgba(0,0,0,0.18)] sm:p-6" data-bottom-motion-contact>
  <div class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-[#E3ECFC] text-[#12499E]" aria-hidden="true">
    {contact.icon === 'headset' ? (
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 14v-3a9 9 0 0 1 18 0v3"/><path d="M3 13h3v7H5a2 2 0 0 1-2-2v-5Zm18 0h-3v7h1a2 2 0 0 0 2-2v-5Z"/></svg>
    ) : (
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 3.09 5.18 2 2 0 0 1 5.09 3h3a2 2 0 0 1 2 1.72l.36 2.81a2 2 0 0 1-.57 1.7L8.09 11a16 16 0 0 0 4.91 4.91l1.77-1.79a2 2 0 0 1 1.7-.57l2.81.36A2 2 0 0 1 22 16.92Z"/></svg>
    )}
  </div>
  <div class="min-w-0">
    <h3 class="text-base font-extrabold leading-tight text-[#0C326E]">{contact.heading}</h3>
    {contact.description && <p class="mt-2 text-sm leading-relaxed text-[#354968]">{contact.description}</p>}
    <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1.5">
      {contact.links.map((link) => (
        <a href={link.href} class="break-all text-sm font-bold leading-relaxed text-[#0944A2] underline decoration-[#9CB7E5] underline-offset-2 hover:text-[#082A62] focus-visible:rounded-sm focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-[#0E52AF]">{link.label}</a>
      ))}
    </div>
  </div>
</article>
