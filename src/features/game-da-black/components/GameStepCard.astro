---
import { Image } from 'astro:assets';
import type { ParticipationStep } from '../types';

interface Props { step: ParticipationStep }
const { step } = Astro.props;
// The canonical description uses ** markers for emphasis. The final sentence
// of step 3 is the conditional bonus, styled separately without changing it.
const sentences = step.number === 3 ? step.description.split(/(?<=\.) (?=Comprando os )/) : [step.description];
const parts = (text: string) => text.split(/(\*\*[^*]+\*\*)/g).filter(Boolean);
---
<article class="step">
  <span class="step-number" aria-hidden="true">{step.number}</span>
  <h3>{step.title}</h3>
  <Image src={step.illustration} alt="" class="illustration" loading="lazy" decoding="async" />
  <p class="step-copy">
    {parts(sentences[0]).map((part) => part.startsWith('**') ? <strong>{part.slice(2, -2)}</strong> : part)}{sentences[1] && ' '}{sentences[1] && <span class="bonus">{parts(sentences[1]).map((part) => part.startsWith('**') ? <strong>{part.slice(2, -2)}</strong> : part)}</span>}
  </p>
  {step.result && <p class="step-copy result">{parts(step.result).map((part) => part.startsWith('**') ? <strong>{part.slice(2, -2)}</strong> : part)}</p>}
  {step.bonus && <p class="step-copy bonus">{parts(step.bonus).map((part) => part.startsWith('**') ? <strong>{part.slice(2, -2)}</strong> : part)}</p>}
</article>
<style>
  .step, .step * { box-sizing: border-box; }
  .step { position:relative; height:100%; display:flex; flex-direction:column; min-width:0; padding:42px 18px 24px; border:1.5px solid #16baff; border-radius:22px; background:linear-gradient(180deg,#052049,#04172f); box-shadow:0 0 5px rgba(22,186,255,.55),0 0 18px rgba(0,108,230,.20); }
  .step-number { position:absolute; top:-23px; left:50%; transform:translateX(-50%); height:46px; min-width:70px; display:grid; place-items:center; padding:0 16px; border-radius:13px; background:linear-gradient(165deg,#fff83f,#ffd500); color:#002255; font-size:30px; font-weight:900; font-style:italic; line-height:1; box-shadow:0 4px 10px rgba(0,0,0,.20); }
  h3 { min-height:64px; display:flex; align-items:center; justify-content:center; text-align:center; padding:10px 12px; border-radius:999px; background:linear-gradient(160deg,#fff139,#ffd800); color:#062958; font-size:18px; font-weight:800; font-style:italic; line-height:1.2; letter-spacing:-.02em; text-wrap:balance; margin:0 0 12px; overflow-wrap:break-word; }
  .illustration { display:block; object-fit:contain; height:190px; width:100%; max-width:260px; margin:0 auto 16px; }
  .step-copy { font-size:15px; line-height:1.4; color:#e0ecff; text-align:center; margin:0; }
  .step-copy strong { font-weight:800; }
  .result { margin-top:10px; }
  .bonus { display:block; border:1px solid #ffe500; border-radius:12px; padding:9px 10px; color:#ffe500; font-weight:600; margin-top:10px; line-height:1.4; }
  @media (min-width:640px) and (max-width:1279px) { .illustration { height:200px; } }
</style>
