---
import { Image } from 'astro:assets';
import type { ParticipationStep } from '../types';

interface Props {
  step: ParticipationStep;
}

const { step } = Astro.props;
---

<article
  class="relative flex h-full min-w-0 flex-col rounded-[24px] border-2 border-[#16baff] bg-[linear-gradient(180deg,#052049_0%,#04172f_100%)] px-4 pb-5 pt-11 text-white shadow-[0_0_7px_rgba(34,195,255,0.9),0_0_23px_rgba(0,99,255,0.36),inset_0_0_16px_rgba(0,98,220,0.18)] transition-[transform,box-shadow] duration-200 motion-safe:hover:-translate-y-1 motion-safe:hover:shadow-[0_0_13px_rgba(34,195,255,1),0_0_30px_rgba(0,99,255,0.5)] motion-reduce:transition-none sm:px-5"
>
  <span
    aria-hidden="true"
    class="absolute -top-[26px] left-1/2 grid h-[52px] min-w-[78px] -translate-x-1/2 place-items-center rounded-[14px] bg-[linear-gradient(165deg,#fff83f,#ffd500)] px-4 text-[2.125rem] font-black leading-none text-[#002255] shadow-[0_5px_14px_rgba(0,0,0,0.25)]"
  >
    {step.number}
  </span>

  <h3
    class="grid min-h-[70px] place-items-center rounded-[15px] bg-[linear-gradient(160deg,#fff139_0%,#ffd800_100%)] px-3 py-2 text-center text-[clamp(1.1rem,1.55vw,1.375rem)] font-black leading-[1.13] text-[#062958] [text-wrap:balance]"
  >
    {step.title}
  </h3>

  <div
    aria-hidden="true"
    class="mx-auto my-2 grid h-[clamp(175px,53vw,235px)] w-full max-w-[290px] place-items-center sm:h-[220px] min-[1201px]:h-[clamp(172px,17vw,248px)]"
  >
    <Image
      src={step.illustration}
      alt=""
      class="block h-full w-full object-contain"
      loading="lazy"
      decoding="async"
      format="webp"
      quality={85}
      sizes="(max-width: 640px) 75vw, (max-width: 1200px) 290px, 22vw"
    />
  </div>

  <div class="mt-auto grid gap-2 text-center">
    <p class="text-[clamp(0.95rem,1.06vw,1.0625rem)] leading-[1.47] text-[#e0ecff]">
      {step.description}
    </p>

    {step.result && (
      <p class="text-base font-extrabold leading-[1.25]">{step.result}</p>
    )}

    {step.bonus && (
      <p class="rounded-xl border-[1.5px] border-[#ffe500] px-2 py-2 text-sm font-bold leading-[1.3] text-[#ffe500]">
        {step.bonus}
      </p>
    )}
  </div>
</article>
