{
  "name": "black-friday-condor-design-system",
  "version": "1.0.0-proposal",
  "status": "proposed-not-official-brand-colors",
  "colors": {
    "core": { "canvas": "#08090D", "surface": "#10141E", "text": "#F5F7FF", "muted": "#B9C4D7", "divider": "#1450D2" },
    "condor": { "primary": "#0003EF", "yellow": "#FFD000" },
    "premia": { "gold": "#D7A91C" },
    "gdb": { "canvas": "#06152D", "surface": "#071D4B", "border": "#00C7FF", "yellow": "#FBE95A" },
    "accessibility": { "focus": "#FBE95A" }
  },
  "typography": {
    "fontFamily": "inherit",
    "display": { "size": "clamp(2.25rem, 4vw, 3.75rem)", "weight": 800, "lineHeight": 1.05 },
    "sectionTitle": { "size": "clamp(1.75rem, 3vw, 2.5rem)", "weight": 800, "lineHeight": 1.15 },
    "cardTitle": { "size": "clamp(1.125rem, 1.5vw, 1.375rem)", "weight": 700, "lineHeight": 1.2 },
    "body": { "size": "1rem", "weight": 400, "lineHeight": 1.5 },
    "caption": { "size": ".875rem", "weight": 400, "lineHeight": 1.45 }
  },
  "layout": {
    "containerMax": "1200px",
    "containerWide": "1280px",
    "gutter": { "mobile": "16px", "tablet": "24px", "desktop": "32px" },
    "sectionGap": { "mobile": "48px", "tablet": "64px", "desktop": "88px" },
    "cardGap": { "mobile": "16px", "tablet": "20px", "desktop": "24px" },
    "cardPadding": { "mobile": "20px", "desktop": "24px" },
    "radiusCard": "20px",
    "radiusControl": "999px"
  },
  "motion": { "ui": "180ms", "entrance": "300ms", "reducedMotion": "disable-decorative-transform" },
  "breakpoints": { "tabletMin": "640px", "desktopFourCardsMin": "1280px" }
}
